# ---- SECRETS: rule #1. Never remove these three lines. ----
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# dependencies
node_modules/
.pnp.*

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# expo (later)
.expo/
*.jks
*.mobileprovision

# turbo / caches
.turbo/
.cache/
coverage/
playwright-report/
test-results/

# locally stored uploads (STORAGE_DRIVER=local) — real users' pictures
var/

# db dumps — may contain real user data
*.sql.gz
*.dump
backups/

# os / editor
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Playwright
test-results/
playwright-report/

# Claude Code: shared config is settings.json; .local.json is personal.
# Globbed, not anchored: a nested vault or app can have its own .claude/ too,
# and the root-anchored pattern silently missed obsidian/.claude/.
**/.claude/settings.local.json
**/.claude/.headroom_wrap_marker.json

# Local scratch from editor tooling — machine-specific, not project config
.serena/
