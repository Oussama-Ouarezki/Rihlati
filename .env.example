# Copy to .env and fill in.  NEVER commit .env — see CLAUDE.md rule #1.
# Anything starting with NEXT_PUBLIC_ or EXPO_PUBLIC_ is visible to the whole
# internet. Never put a secret there.

# ---------- Database ----------
# Matches docker-compose.yml for local dev.
DATABASE_URL="postgresql://rihlati:rihlati_local_dev@localhost:5433/rihlati?schema=public"

# ---------- API ----------
NODE_ENV="development"
API_PORT="4000"
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000"
# Where the web app lives — used to build tracked-link redirects. Not a secret.
WEB_URL="http://localhost:3000"

# ---------- Auth ----------
# Generate real ones with:  openssl rand -base64 48
# Two different secrets. Never reuse one for both.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ---------- Sign in with Google (optional) ----------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Authorized redirect URIs must include:
#   http://localhost:3000/auth/google/callback
#   https://YOUR-DOMAIN/auth/google/callback
# The SECRET is a secret: never prefix it NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- Uploaded images (avatars, agency logos) ----------
# "local" writes to STORAGE_LOCAL_DIR and the API serves it back at /media.
# Fine for development; the API REFUSES to boot with "local" in production,
# because a container's disk is wiped on every deploy and takes the users'
# pictures with it.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./var/uploads"

# Public prefix the stored key is appended to. Point this at your CDN or bucket
# in production. Not a secret.
MEDIA_BASE_URL="http://localhost:4000/media"

# ---------- Observability (rule #4) ----------
SENTRY_DSN=""
LOG_LEVEL="debug"

# ---------- Web ----------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------- Object storage: required when STORAGE_DRIVER="s3" ----------
# Any S3-compatible provider (Scaleway, Backblaze, Wasabi, self-hosted MinIO).
# All five are required together; the API refuses to boot with some missing.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ---------- Later: not used in v1 ----------
# SMS_PROVIDER_KEY=""
